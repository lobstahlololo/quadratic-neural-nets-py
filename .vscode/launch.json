{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug lm_test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/documentation/lm_test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "build and run lm_test",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}